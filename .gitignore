DerivedData/
*.xcuserdata/
*.xcworkspace/xcuserdata/
*.moved-aside
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
build/
Carthage/Build/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Argus runtime data (MUST never be committed: device identity and secrets)
*.key
*.age
device.key
trust.json
join_state.json
argus.log
argus.log.*
.argus/

# Local tooling and env
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.env
.envrc.local
